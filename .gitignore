# 系统
Thumbs.db
desktop.ini
.DS_Store

# 编辑器
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 采集脚本的临时产物
_cache/
*.log
_raw/

# Natural Earth 原始包（50m 约 3MB、10m 约 13MB，仅作缓存，不进仓库）
# 生成物 geo/c*.json 才是要发布的数据
geo/_ne_50m_countries.geojson
geo/_ne_10m_countries.geojson
geo_bak_*/

# 选图核对用的联络表，不进仓库
review/

# 密钥绝不入库 —— key 只走环境变量
.env
.env.*
*.key
secrets.*

# 大模型产物的预览副本（确认后才合进 data/*.json）
data/_llm/

# 一次性运维脚本与本地调试脚本（下划线开头的一律不入库，不是项目代码）
_*.py
_*.json
_*/
geo/_ne_110m_land.geojson

# 贴图源图与本地验证产物（源图 30~40MB，只留生成脚本 scripts/make_textures.py）
_tex/
shots/
_check.js
_shot.py
_shot_m.py

# 采集运行的日志（每国一行 jsonl + 报告），不入库
logs/

# 采集过程的本地中间产物
data/_collect_report.json
data/_ids_unresolved.json
_tmp_*.json

# 压图后的源图：体积 674MB，数据里已经全部指向 .webp，源文件只作本地留档，
# 不进仓库（进了一次就永远在历史里，克隆会变慢）。根目录的 favicon/logo 除外。
assets/*/*.jpg
assets/*/*.jpeg
assets/*/*.png
assets/*/*/*.jpg
assets/*/*/*.png
!assets/favicon.png
!assets/logo.png
