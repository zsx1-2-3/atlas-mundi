    {
      "q": "基里巴斯有什么传统习俗？",
      "a": "村里最重要的公共建筑是maneaba大会所，长辈在里面议事、讲古、裁决纠纷。待客时大家盘腿围坐，先由长者开口才能动食。",
      "tags": [
        "习俗",
        "maneaba",
        "待客"
      ]
    },
    {
      "q": "基里巴斯人平时吃什么？",
      "a": "待客时用椰子叶编的托盘端出整条烤鱼、芋头泥和面包果。日常捕鱼，男人划独木舟下钩，女人在浅滩拾贝、采海菜。",
      "tags": [
        "吃什么",
        "烤鱼",
        "芋头"
      ]
    },
    {
      "q": "基里巴斯有什么好看的地标？",
      "a": "有菲尼克斯群岛保护区、贝蒂奥岛和巴纳巴岛。",
      "tags": [
        "地标",
        "保护区",
        "岛屿"
      ]
    },
    {
      "q": "基里巴斯有什么特别的舞蹈？",
      "a": "舞蹈时众人排成行列，击打木箱作节拍，动作整齐而克制，歌里唱的多是祖先迁徙与海上航行的旧事。",
      "tags": [
        "舞蹈",
        "传统",
        "节拍"
      ]
    },
    {
      "q": "基里巴斯面积多大？",
      "a": "共有32个环礁及1个珊瑚岛，散布于赤道上3,800平方公里的海域。",
      "tags": [
        "面积",
        "环礁",
        "海域"
      ]
    }
  ],
